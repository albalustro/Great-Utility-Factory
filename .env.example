# Utility Factory — environment configuration
#
# Copy to .env.local and fill in what you have. Everything here is optional:
# with no variables set the app runs in local demo mode against an in-memory
# store seeded with clearly-marked demo data.

# --- Supabase (persistence + authentication) --------------------------------
# Set both to switch out of demo mode. Project Settings -> API in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider ------------------------------------------------------------
# Enables the "Analyze opportunity" action. Without it the AI tab shows a
# configuration state and no analysis is ever fabricated.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Not yet implemented ----------------------------------------------------
# Keyword, SERP and Search Analytics providers currently ship with manual
# adapters only. Add a real adapter under src/lib/providers/ and register it in
# src/lib/providers/registry.ts, then read its credentials here.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
